<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Per-user install (no administrator needed) to %LOCALAPPDATA%\Programs\AuroraPad,
    with Start menu and desktop shortcuts and an entry in "Installed apps".
    The UpgradeCode must never change: it lets new versions replace old ones.
  -->
  <Package Name="AuroraPad"
           Manufacturer="AuroraPad"
           Version="$(AppVersion)"
           UpgradeCode="7C1B6E3A-4F2D-4B8E-9A61-3D5E2C9F8A14"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do AuroraPad já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(AssetsDir)\aurorapad.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AuroraPad" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="AppExe" Guid="3E9B6A2C-81F4-4C57-A0D3-6B2F9E4C1D07">
        <File Id="AuroraPadExe" Source="$(AppDir)\AuroraPad.exe" />
        <!-- Per-user components need an HKCU key path. -->
        <RegistryValue Root="HKCU" Key="Software\AuroraPad" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut" Name="AuroraPad" Description="Controles PlayStation no Windows"
                  Target="[#AuroraPadExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\AuroraPad" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutGroup">
      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut" Name="AuroraPad" Description="Controles PlayStation no Windows"
                  Target="[#AuroraPadExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\AuroraPad" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AutoStartGroup">
      <!-- Starts AuroraPad hidden in the tray at sign-in (same entry the app's own setting uses). -->
      <Component Id="AutoStart" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="AuroraPad" Type="string"
                       Value="&quot;[INSTALLFOLDER]AuroraPad.exe&quot; --background" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="CleanupGroup">
      <!-- Remove the "start with Windows" entry the app may have created. -->
      <Component Id="CleanupAutoStart" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\AuroraPad" Name="Cleanup" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\AuroraPad" Name="Installed" Type="integer" Value="1" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="AuroraPad" Description="O programa e o atalho no Menu Iniciar." Level="1" AllowAbsent="no" Display="expand">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="CleanupGroup" />
      <Feature Id="Desktop" Title="Atalho na Área de Trabalho" Description="Cria um atalho do AuroraPad na Área de Trabalho." Level="1">
        <ComponentGroupRef Id="DesktopShortcutGroup" />
      </Feature>
      <Feature Id="Background" Title="Iniciar com o Windows em segundo plano"
               Description="Abre o AuroraPad escondido na bandeja (perto do relógio) quando você entra no Windows, usando pouca memória. Pode ser mudado depois em Configurações." Level="1">
        <ComponentGroupRef Id="AutoStartGroup" />
      </Feature>
    </Feature>

    <!-- Close a running AuroraPad before files are replaced or removed. -->
    <util:CloseApplication Id="CloseAuroraPad" Target="AuroraPad.exe" CloseMessage="yes" RebootPrompt="no" />

    <!-- UI: welcome + license (MIT) + progress, and "Open AuroraPad" on the last page. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Abrir o AuroraPad agora" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AuroraPadExe]" />
    <CustomAction Id="LaunchAuroraPad" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAuroraPad"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
