<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AuroraPad.Core\AuroraPad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WinForms namespaces are not imported globally. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AuroraPad</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationIcon>..\..\assets\aurorapad.ico</ApplicationIcon>
    <Product>AuroraPad</Product>
    <!-- Lighter footprint for an app that mostly runs in the tray. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Description>DualSense, DualSense Edge and DualShock 4 companion for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Ship the ViGEmBus installer next to the exe so the "Instalar ViGEmBus" button works. -->
  <ItemGroup>
    <None Include="..\..\drivers\*.exe" Link="drivers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
