<Window x:Class="AuroraPad.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AuroraPad.App" xmlns:l="clr-namespace:AuroraPad.App.Localization" xmlns:vm="clr-namespace:AuroraPad.App.ViewModels" xmlns:controls="clr-namespace:AuroraPad.App.Controls" Title="AuroraPad" Width="1180" Height="780" MinWidth="900" MinHeight="600" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:PressedBrushConverter x:Key="Pressed" />
        <local:InverseBoolVisibilityConverter x:Key="InvVis" />
        <local:CenterDotConverter x:Key="Center" />

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="190" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="48" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource FgDim}" />
        </Style>
        <Style x:Key="ListDark" TargetType="ListBox">
            <Setter Property="Background" Value="#FF2A2E36" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        </Style>

        <DataTemplate x:Key="TriggerEditor" DataType="{x:Type vm:TriggerEditorViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.mode}" />
                        <ComboBox ItemsSource="{x:Static vm:TriggerEditorViewModel.Modes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Left" Width="260" />
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource Secondary}">
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="Command" Value="{Binding ApplyPresetCommand}" />
                            </Style>
                        </WrapPanel.Resources>
                        <TextBlock Text="{l:T trg.presets}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <Button Content="{l:T preset.pistol}" CommandParameter="pistol" />
                        <Button Content="{l:T preset.rifle}" CommandParameter="rifle" />
                        <Button Content="{l:T preset.bow}" CommandParameter="bow" />
                        <Button Content="{l:T preset.brake}" CommandParameter="brake" />
                        <Button Content="{l:T preset.accel}" CommandParameter="accel" />
                        <Button Content="{l:T preset.horse}" CommandParameter="horse" />
                        <Button Content="{l:T preset.machine}" CommandParameter="machine" />
                        <Button Content="{l:T preset.rough}" CommandParameter="rough" />
                        <Button Content="{l:T preset.off}" CommandParameter="off" />
                    </WrapPanel>
                    <!-- Resistance graph: 10 zones along the trigger travel + live press marker -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{l:T trg.graph}" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                        <Grid Width="300" Height="64" HorizontalAlignment="Left" Background="#FF15171C">
                            <ItemsControl ItemsSource="{Binding Zones}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Height="{Binding Height}" Margin="1.5,0" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="#FF3A4F70" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Reached}" Value="True"><Setter Property="Fill" Value="#FF2E8BFF" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Vibrates}" Value="True"><Setter Property="Fill" Value="#FFB45CFF" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas>
                                <Rectangle Width="2" Height="64" Fill="White" Canvas.Left="{Binding LiveMarker}" Opacity="0.9" />
                            </Canvas>
                        </Grid>
                        <DockPanel Width="300" HorizontalAlignment="Left">
                            <TextBlock Text="{l:T trg.released}" Style="{StaticResource Dim}" FontSize="11" />
                            <TextBlock Text="{l:T trg.pressed}" Style="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowStart, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.start}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Start}" />
                        <Slider Minimum="0" Maximum="9" Value="{Binding Start}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowEnd, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.end}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding End}" />
                        <Slider Minimum="1" Maximum="9" Value="{Binding End}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowStrength, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.strength}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Strength}" />
                        <Slider Minimum="1" Maximum="8" Value="{Binding Strength}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowStrengthB, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{Binding StrengthBLabel}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding StrengthB}" />
                        <Slider Minimum="0" Maximum="8" Value="{Binding StrengthB}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowSnapForce, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.snap}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding SnapForce}" />
                        <Slider Minimum="1" Maximum="8" Value="{Binding SnapForce}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowFrequency, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.frequency}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Frequency}" />
                        <Slider Minimum="1" Maximum="60" Value="{Binding Frequency}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowPeriod, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.period}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Period}" />
                        <Slider Minimum="1" Maximum="50" Value="{Binding Period}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowFeet, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.foot1}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding FirstFoot}" />
                        <Slider Minimum="0" Maximum="6" Value="{Binding FirstFoot}" />
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding ShowFeet, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.foot2}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding SecondFoot}" />
                        <Slider Minimum="1" Maximum="7" Value="{Binding SecondFoot}" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{l:T trg.threshold}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Threshold}" />
                        <Slider Minimum="0" Maximum="255" Value="{Binding Threshold}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Fg}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SidebarBrush}" BorderBrush="#FF1C202A" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="22,22,12,18">
                                    <TextBlock Text="AuroraPad" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AuroraBrush}" />
                                    <TextBlock Text="{l:T app.subtitle}" Style="{StaticResource Dim}" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ================= HOME ================= -->
            <TabItem Header="{l:T nav.home}" Tag="&#xE80F;" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Style="{StaticResource H1}" Text="{l:T home.title}" />
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasControllers, Converter={StaticResource InvVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Style="{StaticResource H2}" Text="{l:T home.none}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Dim}" Text="{l:T home.noneHint}" />
                                    <TextBlock Style="{StaticResource Dim}" Text="{l:T home.btHint}" Margin="0,8,0,0" />
                                </StackPanel>
                                <controls:DualSenseView Height="300" Opacity="0.55" DataContext="{x:Static vm:IdlePadViewModel.Instance}" />
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Controllers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" Text="{Binding ConnectionLabel}" />
                                                <TextBlock Style="{StaticResource Dim}" Text="{Binding EmulationLabel}" />
                                                <TextBlock Style="{StaticResource Dim}" Text="{Binding HapticsLabel}" />
                                                <TextBlock Text="{l:T home.battery}" Style="{StaticResource Dim}" Margin="0,14,0,0" />
                                                <ProgressBar Value="{Binding Battery}" Maximum="100" Height="8" Margin="0,4" Background="{StaticResource Off}" Foreground="#FF34C759" BorderThickness="0" />
                                                <TextBlock Text="{Binding BatteryLabel}" />
                                            </StackPanel>
                                            <controls:DualSenseView Height="300" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T home.activeProfile}" />
                                <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Left" Width="280" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T home.activity}" />
                                <ItemsControl ItemsSource="{Binding LogLines}" MaxHeight="220">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Dim}" FontFamily="Consolas" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= LIVE INPUT ================= -->
            <TabItem Header="{l:T nav.live}" Tag="&#xE7FC;" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <DockPanel Margin="0,0,0,16">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Controllers}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedController}" Width="220" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource H1}" Text="{l:T live.title}" Margin="0" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding HasControllers, Converter={StaticResource InvVis}}">
                            <TextBlock Style="{StaticResource Dim}" Text="{l:T live.connect}" Margin="0,0,0,12" />
                            <Border Style="{StaticResource Card}">
                                <controls:DualSenseView Height="440" Opacity="0.55" DataContext="{x:Static vm:IdlePadViewModel.Instance}" />
                            </Border>
                        </StackPanel>

                        <StackPanel DataContext="{Binding SelectedController}" Visibility="{Binding DataContext.HasControllers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource Card}">
                                <controls:DualSenseView Height="440" />
                            </Border>
                            <WrapPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{l:T live.sticks}" />
                                        <WrapPanel>
                                            <Grid Margin="0,0,24,0">
                                                <Ellipse Width="100" Height="100" Fill="#FF2A2E36" />
                                                <Canvas Width="100" Height="100">
                                                    <Ellipse Width="16" Height="16" Fill="{Binding L3, Converter={StaticResource Pressed}}" Stroke="White" StrokeThickness="1" Canvas.Left="{Binding LeftX, Converter={StaticResource Center}, ConverterParameter=16}" Canvas.Top="{Binding LeftY, Converter={StaticResource Center}, ConverterParameter=16}" />
                                                </Canvas>
                                            </Grid>
                                            <Grid>
                                                <Ellipse Width="100" Height="100" Fill="#FF2A2E36" />
                                                <Canvas Width="100" Height="100">
                                                    <Ellipse Width="16" Height="16" Fill="{Binding R3, Converter={StaticResource Pressed}}" Stroke="White" StrokeThickness="1" Canvas.Left="{Binding RightX, Converter={StaticResource Center}, ConverterParameter=16}" Canvas.Top="{Binding RightY, Converter={StaticResource Center}, ConverterParameter=16}" />
                                                </Canvas>
                                            </Grid>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Width="260">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{l:T live.triggers}" />
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="L2" Width="30" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding L2}" Width="34" TextAlignment="Right" />
                                            <ProgressBar Value="{Binding L2, Mode=OneWay}" Maximum="255" Height="10" Background="{StaticResource Off}" Foreground="{StaticResource Accent}" BorderThickness="0" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="R2" Width="30" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding R2}" Width="34" TextAlignment="Right" />
                                            <ProgressBar Value="{Binding R2, Mode=OneWay}" Maximum="255" Height="10" Background="{StaticResource Off}" Foreground="{StaticResource Accent}" BorderThickness="0" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Touchpad" />
                                        <Border Width="240" Height="120" CornerRadius="6" Background="{Binding Touchpad, Converter={StaticResource Pressed}}">
                                            <Canvas>
                                                <Ellipse Width="14" Height="14" Fill="White" Visibility="{Binding Touch1Active, Converter={StaticResource BoolVis}}" Canvas.Left="{Binding Touch1X, Converter={StaticResource Center}, ConverterParameter=14}" Canvas.Top="{Binding Touch1Y, Converter={StaticResource Center}, ConverterParameter=14}" />
                                                <Ellipse Width="14" Height="14" Fill="#FFFFC107" Visibility="{Binding Touch2Active, Converter={StaticResource BoolVis}}" Canvas.Left="{Binding Touch2X, Converter={StaticResource Center}, ConverterParameter=14}" Canvas.Top="{Binding Touch2Y, Converter={StaticResource Center}, ConverterParameter=14}" />
                                            </Canvas>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="{l:T live.buttons}" />
                                    <WrapPanel>
                                        <WrapPanel.Resources>
                                            <Style TargetType="Border" BasedOn="{StaticResource Key}">
                                                <Setter Property="Width" Value="64" />
                                            </Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="11" />
                                            </Style>
                                        </WrapPanel.Resources>
                                        <Border Background="{Binding Cross, Converter={StaticResource Pressed}}"><TextBlock Text="✕" /></Border>
                                        <Border Background="{Binding Circle, Converter={StaticResource Pressed}}"><TextBlock Text="○" /></Border>
                                        <Border Background="{Binding Square, Converter={StaticResource Pressed}}"><TextBlock Text="□" /></Border>
                                        <Border Background="{Binding Triangle, Converter={StaticResource Pressed}}"><TextBlock Text="△" /></Border>
                                        <Border Background="{Binding L1, Converter={StaticResource Pressed}}"><TextBlock Text="L1" /></Border>
                                        <Border Background="{Binding R1, Converter={StaticResource Pressed}}"><TextBlock Text="R1" /></Border>
                                        <Border Background="{Binding L3, Converter={StaticResource Pressed}}"><TextBlock Text="L3" /></Border>
                                        <Border Background="{Binding R3, Converter={StaticResource Pressed}}"><TextBlock Text="R3" /></Border>
                                        <Border Background="{Binding Up, Converter={StaticResource Pressed}}"><TextBlock Text="▲" /></Border>
                                        <Border Background="{Binding Down, Converter={StaticResource Pressed}}"><TextBlock Text="▼" /></Border>
                                        <Border Background="{Binding Left, Converter={StaticResource Pressed}}"><TextBlock Text="◀" /></Border>
                                        <Border Background="{Binding Right, Converter={StaticResource Pressed}}"><TextBlock Text="▶" /></Border>
                                        <Border Background="{Binding Create, Converter={StaticResource Pressed}}"><TextBlock Text="Create" /></Border>
                                        <Border Background="{Binding Options, Converter={StaticResource Pressed}}"><TextBlock Text="Options" /></Border>
                                        <Border Background="{Binding Ps, Converter={StaticResource Pressed}}"><TextBlock Text="PS" /></Border>
                                        <Border Background="{Binding Mute, Converter={StaticResource Pressed}}"><TextBlock Text="{l:T live.mute}" /></Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="{l:T live.motion}" />
                                    <WrapPanel>
                                        <TextBlock Text="{l:T live.gyro}" Width="110" Style="{StaticResource Dim}" />
                                        <TextBlock Text="{Binding Gyro}" FontFamily="Consolas" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="{l:T live.accel}" Width="110" Style="{StaticResource Dim}" />
                                        <TextBlock Text="{Binding Accel}" FontFamily="Consolas" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= ADAPTIVE TRIGGERS ================= -->
            <TabItem Header="{l:T nav.triggers}" Tag="&#xE945;" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Style="{StaticResource H1}" Text="{l:T trg.title}" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,14" Text="{l:T trg.hint}" />
                        <ContentControl Content="{Binding LeftTrigger}" ContentTemplate="{StaticResource TriggerEditor}" />
                        <ContentControl Content="{Binding RightTrigger}" ContentTemplate="{StaticResource TriggerEditor}" />
                        <WrapPanel>
                            <Button Content="{l:T trg.resetMods}" Command="{Binding ResetModOverridesCommand}" Style="{StaticResource Secondary}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= LIGHTING ================= -->
            <TabItem Header="{l:T nav.lighting}" Tag="&#xE781;" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Style="{StaticResource H1}" Text="{l:T light.title}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T light.lightbar}" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="120" Height="120" CornerRadius="60" Margin="20,0,0,0" Background="{Binding PreviewBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="2" />
                                    <StackPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:T light.red}" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Red}" />
                                            <Slider Minimum="0" Maximum="255" Value="{Binding Red}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:T light.green}" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Green}" />
                                            <Slider Minimum="0" Maximum="255" Value="{Binding Green}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:T light.blue}" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Blue}" />
                                            <Slider Minimum="0" Maximum="255" Value="{Binding Blue}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:T light.brightness}" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="{Binding Brightness}" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <WrapPanel.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Width" Value="30" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Command" Value="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Setter Property="CommandParameter" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button Background="#FFFF0000" />
                                            <Button Background="#FFFF7F00" />
                                            <Button Background="#FFFFFF00" />
                                            <Button Background="#FF00FF00" />
                                            <Button Background="#FF00FFFF" />
                                            <Button Background="#FF0078FF" />
                                            <Button Background="#FF0000FF" />
                                            <Button Background="#FF8000FF" />
                                            <Button Background="#FFFF00FF" />
                                            <Button Background="#FFFFFFFF" />
                                        </WrapPanel>
                                        <CheckBox Content="{l:T light.battery}" IsChecked="{Binding BatteryLightbar}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T light.players}" />
                                <TextBlock Style="{StaticResource Dim}" Text="{l:T light.dualsenseOnly}" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <CheckBox IsChecked="{Binding Led1}" Content="1" />
                                    <CheckBox IsChecked="{Binding Led2}" Content="2" />
                                    <CheckBox IsChecked="{Binding Led3}" Content="3" />
                                    <CheckBox IsChecked="{Binding Led4}" Content="4" />
                                    <CheckBox IsChecked="{Binding Led5}" Content="5" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="{l:T light.presets}" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Dim}" />
                                    <Button Style="{StaticResource Secondary}" Content="{l:T light.p1}" Command="{Binding SetPlayerCommand}" CommandParameter="1" />
                                    <Button Style="{StaticResource Secondary}" Content="{l:T light.p2}" Command="{Binding SetPlayerCommand}" CommandParameter="2" />
                                    <Button Style="{StaticResource Secondary}" Content="{l:T light.p3}" Command="{Binding SetPlayerCommand}" CommandParameter="3" />
                                    <Button Style="{StaticResource Secondary}" Content="{l:T light.p4}" Command="{Binding SetPlayerCommand}" CommandParameter="4" />
                                    <Button Style="{StaticResource Secondary}" Content="{l:T light.off}" Command="{Binding SetPlayerCommand}" CommandParameter="0" />
                                </WrapPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:T light.ledBrightness}" />
                                    <ComboBox ItemsSource="{Binding LedBrightnesses}" SelectedItem="{Binding PlayerLedBrightness}" HorizontalAlignment="Left" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:T light.mic}" />
                                <ComboBox ItemsSource="{Binding MicModes}" SelectedItem="{Binding MicLed}" HorizontalAlignment="Left" />
                            </DockPanel>
