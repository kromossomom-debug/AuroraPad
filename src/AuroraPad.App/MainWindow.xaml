                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Style="{StaticResource H1}" Text="{l:T emu.title}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T emu.virtual}" />
                                <TextBlock Style="{StaticResource Dim}" Text="{Binding VigemStatus}" Margin="0,0,0,8" />
                                <Button Content="{l:T emu.installVigem}" Command="{Binding InstallVigemCommand}" HorizontalAlignment="Left" Visibility="{Binding VigemMissing, Converter={StaticResource BoolVis}}" Margin="0,0,0,8" />
                                <DockPanel Margin="0,4">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:T emu.as}" />
                                    <ComboBox ItemsSource="{Binding EmulationModes}" SelectedItem="{Binding SelectedEmulation}" HorizontalAlignment="Left" />
                                </DockPanel>
                                <CheckBox Content="{l:T emu.swap}" IsChecked="{Binding SwapAB}" />
                                <CheckBox Content="{l:T emu.gameLightbar}" IsChecked="{Binding UseGameLightbar}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" Text="{l:T emu.ds4Motion}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T hh.title}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8" Text="{l:T hh.hint}" />
                                <CheckBox Content="{l:T hh.enable}" IsChecked="{Binding UseHidHide}" IsEnabled="{Binding HidHideInstalled}" />
                                <TextBlock Text="{Binding HidHideStatus}" Style="{StaticResource Dim}" Margin="0,4,0,8" />
                                <Button Content="{l:T hh.download}" Command="{Binding OpenHidHidePageCommand}" HorizontalAlignment="Left" Style="{StaticResource Secondary}" Visibility="{Binding HidHideInstalled, Converter={StaticResource InvVis}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T udp.title}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8" Text="{l:T udp.hint}" />
                                <CheckBox Content="{l:T udp.enable}" IsChecked="{Binding UseUdp}" />
                                <WrapPanel Margin="0,6">
                                    <TextBlock Text="{l:T common.port}" VerticalAlignment="Center" Width="70" />
                                    <TextBox Text="{Binding UdpPort, UpdateSourceTrigger=LostFocus}" Width="100" />
                                </WrapPanel>
                                <TextBlock Text="{Binding UdpStatus}" Style="{StaticResource Dim}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T dsu.title}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8" Text="{l:T dsu.hint}" />
                                <CheckBox Content="{l:T dsu.enable}" IsChecked="{Binding UseDsu}" />
                                <WrapPanel Margin="0,6">
                                    <TextBlock Text="{l:T common.port}" VerticalAlignment="Center" Width="70" />
                                    <TextBox Text="{Binding DsuPort, UpdateSourceTrigger=LostFocus}" Width="100" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DsuStatus}" Style="{StaticResource Dim}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T osc.title}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8" Text="{l:T osc.hint}" />
                                <CheckBox Content="{l:T osc.enable}" IsChecked="{Binding UseOsc}" />
                                <WrapPanel Margin="0,6">
                                    <TextBlock Text="{l:T common.address}" VerticalAlignment="Center" Width="70" />
                                    <TextBox Text="{Binding OscAddress, UpdateSourceTrigger=LostFocus}" Width="140" Margin="0,0,16,0" />
                                    <TextBlock Text="{l:T common.port}" VerticalAlignment="Center" Width="50" />
                                    <TextBox Text="{Binding OscPort, UpdateSourceTrigger=LostFocus}" Width="100" />
                                </WrapPanel>
                                <TextBlock Text="{Binding OscStatus}" Style="{StaticResource Dim}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= GUIDE ================= -->
            <TabItem Header="{l:T nav.guide}" Tag="&#xE897;" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Style="{StaticResource H1}" Text="{l:T guide.title}" />
                        <ItemsControl ItemsSource="{Binding GuideTopics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ================= SETTINGS ================= -->
            <TabItem Header="{l:T nav.settings}" Tag="&#xE713;" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Style="{StaticResource H1}" Text="{l:T set.title}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T set.language}" />
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Left" Width="240" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" Text="{l:T set.languageHint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T set.window}" />
                                <CheckBox Content="{l:T set.boot}" IsChecked="{Binding LaunchOnBoot}" />
                                <CheckBox Content="{l:T set.startMin}" IsChecked="{Binding StartMinimized}" />
                                <CheckBox Content="{l:T set.tray}" IsChecked="{Binding MinimizeToTray}" />
                                <CheckBox Content="{l:T set.lowBattery}" IsChecked="{Binding LowBatteryAlert}" />
                                <TextBlock Text="{l:T set.backgroundHint}" Style="{StaticResource Dim}" Margin="0,8,0,2" />
                                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Dim}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T set.autoProfiles}" />
                                <CheckBox Content="{l:T set.autoSwitch}" IsChecked="{Binding AutoSwitchProfiles}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" Text="{Binding ActiveGameLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T sc.title}" />
                                <CheckBox Content="{l:T sc.enable}" IsChecked="{Binding EnableShortcuts}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,8" Text="{l:T sc.hint}" />
                                <ItemsControl ItemsSource="{Binding ShortcutList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ================= SUPPORT ================= -->
            <TabItem Header="{l:T nav.support}" Tag="&#xEB51;" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Style="{StaticResource H1}" Text="{l:T sup.title}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{l:T sup.bmcTitle}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,12" Text="{l:T sup.hint}" />
                                <Button Command="{Binding OpenBuyMeACoffeeCommand}" Background="#FFFFDD00" Foreground="#FF1A1A1A" Padding="20,10" HorizontalAlignment="Left">
                                    <TextBlock Text="☕  Buy Me a Coffee" FontSize="15" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="White" CornerRadius="12" Padding="10" Margin="0,0,24,0" VerticalAlignment="Top">
                                    <Image Source="/Assets/pix-qr.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource H2}" Text="{l:T sup.pixTitle}" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,12" Text="{l:T sup.pixHint}" />
                                    <TextBlock Style="{StaticResource Dim}" Text="{l:T sup.pixKey}" />
                                    <TextBox Text="{Binding PixKeyText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,4,0,12" MaxWidth="420" HorizontalAlignment="Left" />
                                    <WrapPanel>
                                        <Button Content="{l:T sup.copyKey}" Command="{Binding CopyPixKeyCommand}" />
                                        <Button Content="{l:T sup.copyCode}" Command="{Binding CopyPixCodeCommand}" Style="{StaticResource Secondary}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SupportStatus}" Foreground="#FF34C759" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Dim}" Text="{l:T sup.thanks}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#FF111317">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="16,0" />
        </Border>
    </Grid>
</Window>
