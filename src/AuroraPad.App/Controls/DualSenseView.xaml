<UserControl x:Class="AuroraPad.App.Controls.DualSenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AuroraPad.App">
    <!-- Original vector illustration of a two-tone PS5-style controller. DataContext: ControllerViewModel.
         Everything reacts live: buttons light up, sticks move, triggers fill, touchpad shows fingers,
         lightbar and player LEDs show the colours actually sent to the controller. -->
    <UserControl.Resources>
        <local:PressedBrushConverter x:Key="Pressed" />
        <SolidColorBrush x:Key="Shell" Color="#FFF3F4F6" />
        <SolidColorBrush x:Key="ShellEdge" Color="#FFC9CDD3" />
        <SolidColorBrush x:Key="Core" Color="#FF15161A" />
        <SolidColorBrush x:Key="Key" Color="#FF24262C" />
        <SolidColorBrush x:Key="Glyph" Color="#FFB4B9C2" />
        <SolidColorBrush x:Key="Hot" Color="#FF2E8BFF" />

        <!-- A face/system button: dark when idle, glows when pressed. -->
        <Style x:Key="Btn" TargetType="Shape">
            <Setter Property="Fill" Value="{StaticResource Key}" />
            <Setter Property="Stroke" Value="#FF34373F" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <DropShadowEffect x:Key="Glow" Color="#FF2E8BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.9" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="600" Height="400">

            <!-- ===== Triggers L2 / R2 (fill with analog pressure) ===== -->
            <Border Canvas.Left="102" Canvas.Top="6" Width="92" Height="32" CornerRadius="10,10,4,4" Background="#FF2A2C32" BorderBrush="#FF3A3D45" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Rectangle VerticalAlignment="Bottom" Height="{Binding L2Height}" Fill="{StaticResource Hot}" Opacity="0.85" />
                    <TextBlock Text="L2" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Canvas.Left="406" Canvas.Top="6" Width="92" Height="32" CornerRadius="10,10,4,4" Background="#FF2A2C32" BorderBrush="#FF3A3D45" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Rectangle VerticalAlignment="Bottom" Height="{Binding R2Height}" Fill="{StaticResource Hot}" Opacity="0.85" />
                    <TextBlock Text="R2" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ===== Bumpers L1 / R1 ===== -->
            <Path Data="M 92,66 C 118,48 160,42 202,47 L 200,60 C 160,56 124,62 100,76 Z"
                  Fill="{Binding L1, Converter={StaticResource Pressed}}" Stroke="#FF3A3D45" StrokeThickness="1" />
            <Path Data="M 508,66 C 482,48 440,42 398,47 L 400,60 C 440,56 476,62 500,76 Z"
                  Fill="{Binding R1, Converter={StaticResource Pressed}}" Stroke="#FF3A3D45" StrokeThickness="1" />

            <!-- ===== Body: white shell ===== -->
            <Path Fill="{StaticResource Shell}" Stroke="{StaticResource ShellEdge}" StrokeThickness="2"
                  Data="M 300,58 C 360,58 405,52 445,60 C 500,70 535,95 553,140 C 575,190 600,280 592,335 C 586,372 548,392 518,370 C 492,350 470,305 446,282 C 425,262 400,258 300,258 C 200,258 175,262 154,282 C 130,305 108,350 82,370 C 52,392 14,372 8,335 C 0,280 25,190 47,140 C 65,95 100,70 155,60 C 195,52 240,58 300,58 Z">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
                </Path.Effect>
            </Path>
            <!-- Subtle grip shading -->
            <Path Fill="#14000000" Data="M 47,140 C 25,190 0,280 8,335 C 14,372 52,392 82,370 C 70,360 40,330 46,270 C 50,220 60,180 70,150 Z" />
            <Path Fill="#14000000" Data="M 553,140 C 575,190 600,280 592,335 C 586,372 548,392 518,370 C 530,360 560,330 554,270 C 550,220 540,180 530,150 Z" />

            <!-- ===== Black core ===== -->
            <Path Fill="{StaticResource Core}"
                  Data="M 205,62 L 395,62 C 420,110 432,170 430,210 C 428,242 410,258 380,258 L 220,258 C 190,258 172,242 170,210 C 168,170 180,110 205,62 Z" />

            <!-- ===== Lightbar (both sides of the touchpad) ===== -->
            <Path Data="M 211,70 C 204,100 200,128 202,152" Stroke="{Binding LightbarBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect Color="{Binding LightbarColor}" BlurRadius="16" ShadowDepth="0" Opacity="1" />
                </Path.Effect>
            </Path>
            <Path Data="M 389,70 C 396,100 400,128 398,152" Stroke="{Binding LightbarBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect Color="{Binding LightbarColor}" BlurRadius="16" ShadowDepth="0" Opacity="1" />
                </Path.Effect>
            </Path>

            <!-- ===== Touchpad ===== -->
            <Border Canvas.Left="215" Canvas.Top="56" Width="170" Height="96" CornerRadius="6,6,14,14" Background="#FFE9EBEE">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#FFC4C8CE" />
                        <Setter Property="BorderThickness" Value="1.5" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TouchpadMouseOn}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF34C759" />
                                <Setter Property="BorderThickness" Value="3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Touchpad}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Hot}" />
                                <Setter Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Ellipse Width="12" Height="12" Fill="{StaticResource Hot}" Canvas.Left="{Binding T1Left}" Canvas.Top="{Binding T1Top}"
                     Visibility="{Binding Touch1Active, Converter={StaticResource BoolVis}}" Effect="{StaticResource Glow}" />
            <Ellipse Width="12" Height="12" Fill="#FFFFB020" Canvas.Left="{Binding T2Left}" Canvas.Top="{Binding T2Top}"
                     Visibility="{Binding Touch2Active, Converter={StaticResource BoolVis}}" />

            <!-- ===== Player LEDs ===== -->
            <StackPanel Canvas.Left="281" Canvas.Top="158" Orientation="Horizontal" Visibility="{Binding IsDualSense, Converter={StaticResource BoolVis}}">
                <StackPanel.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="5" />
                        <Setter Property="Height" Value="2.5" />
                        <Setter Property="Margin" Value="1.5,0" />
                        <Setter Property="RadiusX" Value="1" />
                        <Setter Property="RadiusY" Value="1" />
                        <Setter Property="Fill" Value="#FF3A3D45" />
                    </Style>
                </StackPanel.Resources>
                <Rectangle Tag="1"><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource {x:Type Rectangle}}"><Style.Triggers><DataTrigger Binding="{Binding Led1On}" Value="True"><Setter Property="Fill" Value="White" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                <Rectangle><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource {x:Type Rectangle}}"><Style.Triggers><DataTrigger Binding="{Binding Led2On}" Value="True"><Setter Property="Fill" Value="White" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                <Rectangle><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource {x:Type Rectangle}}"><Style.Triggers><DataTrigger Binding="{Binding Led3On}" Value="True"><Setter Property="Fill" Value="White" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                <Rectangle><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource {x:Type Rectangle}}"><Style.Triggers><DataTrigger Binding="{Binding Led4On}" Value="True"><Setter Property="Fill" Value="White" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                <Rectangle><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource {x:Type Rectangle}}"><Style.Triggers><DataTrigger Binding="{Binding Led5On}" Value="True"><Setter Property="Fill" Value="White" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
            </StackPanel>

            <!-- ===== Create / Options ===== -->
            <Rectangle Canvas.Left="186" Canvas.Top="70" Width="8" Height="18" RadiusX="4" RadiusY="4" Style="{StaticResource Btn}"
                       Fill="{Binding Create, Converter={StaticResource Pressed}}">
                <Rectangle.RenderTransform><RotateTransform Angle="-12" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Canvas.Left="406" Canvas.Top="68" Width="8" Height="18" RadiusX="4" RadiusY="4" Style="{StaticResource Btn}"
                       Fill="{Binding Options, Converter={StaticResource Pressed}}">
                <Rectangle.RenderTransform><RotateTransform Angle="12" /></Rectangle.RenderTransform>
            </Rectangle>

            <!-- ===== D-pad ===== -->
            <Path Style="{StaticResource Btn}" Fill="{Binding Up, Converter={StaticResource Pressed}}" Data="M 110,110 H 130 V 132 L 120,142 L 110,132 Z" />
            <Path Style="{StaticResource Btn}" Fill="{Binding Down, Converter={StaticResource Pressed}}" Data="M 110,190 H 130 V 168 L 120,158 L 110,168 Z" />
            <Path Style="{StaticResource Btn}" Fill="{Binding Left, Converter={StaticResource Pressed}}" Data="M 80,140 V 160 H 102 L 112,150 L 102,140 Z" />
            <Path Style="{StaticResource Btn}" Fill="{Binding Right, Converter={StaticResource Pressed}}" Data="M 160,140 V 160 H 138 L 128,150 L 138,140 Z" />

            <!-- ===== Face buttons ===== -->
            <!-- Triangle -->
            <Ellipse Canvas.Left="465" Canvas.Top="101" Width="30" Height="30" Style="{StaticResource Btn}" Fill="{Binding Triangle, Converter={StaticResource Pressed}}" />
            <Path Data="M 480,108 L 488,122 H 472 Z" Stroke="{StaticResource Glyph}" StrokeThickness="2" StrokeLineJoin="Round">
                <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding Triangle}" Value="True"><Setter Property="Stroke" Value="#FF3EE0B4" /></DataTrigger></Style.Triggers></Style></Path.Style>
            </Path>
            <!-- Circle -->
            <Ellipse Canvas.Left="499" Canvas.Top="135" Width="30" Height="30" Style="{StaticResource Btn}" Fill="{Binding Circle, Converter={StaticResource Pressed}}" />
            <Ellipse Canvas.Left="507" Canvas.Top="143" Width="14" Height="14" StrokeThickness="2">
                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Stroke" Value="{StaticResource Glyph}" /><Style.Triggers><DataTrigger Binding="{Binding Circle}" Value="True"><Setter Property="Stroke" Value="#FFFF5A70" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
            </Ellipse>
            <!-- Cross -->
            <Ellipse Canvas.Left="465" Canvas.Top="169" Width="30" Height="30" Style="{StaticResource Btn}" Fill="{Binding Cross, Converter={StaticResource Pressed}}" />
            <Path Data="M 474,178 L 486,190 M 486,178 L 474,190" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="{StaticResource Glyph}" /><Style.Triggers><DataTrigger Binding="{Binding Cross}" Value="True"><Setter Property="Stroke" Value="#FF6FA8FF" /></DataTrigger></Style.Triggers></Style></Path.Style>
            </Path>
            <!-- Square -->
            <Ellipse Canvas.Left="431" Canvas.Top="135" Width="30" Height="30" Style="{StaticResource Btn}" Fill="{Binding Square, Converter={StaticResource Pressed}}" />
            <Rectangle Canvas.Left="440" Canvas.Top="144" Width="12" Height="12" StrokeThickness="2">
                <Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Stroke" Value="{StaticResource Glyph}" /><Style.Triggers><DataTrigger Binding="{Binding Square}" Value="True"><Setter Property="Stroke" Value="#FFF08CF0" /></DataTrigger></Style.Triggers></Style></Rectangle.Style>
            </Rectangle>

            <!-- ===== Sticks ===== -->
            <Ellipse Canvas.Left="194" Canvas.Top="178" Width="68" Height="68" Fill="#FF0B0C0E" Stroke="#FF2A2C32" StrokeThickness="2" />
            <Ellipse Canvas.Left="338" Canvas.Top="178" Width="68" Height="68" Fill="#FF0B0C0E" Stroke="#FF2A2C32" StrokeThickness="2" />
            <Grid Canvas.Left="{Binding LCapLeft}" Canvas.Top="{Binding LCapTop}" Width="42" Height="42">
                <Ellipse Fill="{Binding L3, Converter={StaticResource Pressed}}" Stroke="#FF4A4E57" StrokeThickness="2" />
                <Ellipse Margin="9" Stroke="#FF15161A" StrokeThickness="2" />
            </Grid>
            <Grid Canvas.Left="{Binding RCapLeft}" Canvas.Top="{Binding RCapTop}" Width="42" Height="42">
                <Ellipse Fill="{Binding R3, Converter={StaticResource Pressed}}" Stroke="#FF4A4E57" StrokeThickness="2" />
                <Ellipse Margin="9" Stroke="#FF15161A" StrokeThickness="2" />
            </Grid>

            <!-- ===== Home (PS) and mute ===== -->
            <Grid Canvas.Left="288" Canvas.Top="212" Width="24" Height="24">
                <Ellipse Style="{StaticResource Btn}" Fill="{Binding Ps, Converter={StaticResource Pressed}}" />
                <TextBlock Text="PS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Rectangle Canvas.Left="290" Canvas.Top="241" Width="20" Height="6" RadiusX="3" RadiusY="3">
                <Rectangle.Style>
                    <Style TargetType="Rectangle" BasedOn="{StaticResource Btn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MicOn}" Value="True"><Setter Property="Fill" Value="#FFFF8A3D" /></DataTrigger>
                            <DataTrigger Binding="{Binding Mute}" Value="True"><Setter Property="Fill" Value="{StaticResource Hot}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- Speaker grille dots -->
            <ItemsControl Canvas.Left="281" Canvas.Top="172" ItemsSource="{x:Static local:Grille.Dots}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Width="38" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Ellipse Width="2" Height="2" Margin="1.3" Fill="#FF3A3D45" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</UserControl>
